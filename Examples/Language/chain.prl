-- Written sequentially; `prl par` regroups it into stages and prints the parallel program.
-- One register per segment: a segment that reuses an earlier one is not register-closed, and
-- the pass declines rather than guessing. -- ref: docs/autopar-algorithm.md

buf a[5]

a[0] := 3
a[1] := 4
%0 := a[0]
a[2] := %0 * %0
%1 := a[1]
a[3] := %1 * %1
%2 := a[2]
%3 := a[3]
a[4] := %2 + %3
